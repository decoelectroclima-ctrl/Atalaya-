<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ADRIANA • CONTACTO CERO"
            android:textColor="@color/soltar_amber"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_phase_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/soltar_surface_elevated"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="🛡️ Soberanía"
            android:textColor="@color/soltar_sage"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Days Counter Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_days_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_days_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DÍAS DE LIBERTAD"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_days_subtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cuidando tu dignidad y paz"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quote / Daily Reflection -->
    <TextView
        android:id="@+id/widget_quote_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="«Sé dueño de tus juicios y serás dueño de tu paz.» — Epicteto"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="italic" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_sos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_sos_button_bg"
            android:paddingHorizontal="4dp"
            android:text="🚨 SOS IMPULSO"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_btn_journal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_action_button_bg"
            android:paddingHorizontal="4dp"
            android:text="📖 DIARIO"
            android:textColor="@color/soltar_amber"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
